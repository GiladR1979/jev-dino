{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@chromium/offline": ["./src/chromium-host.d.ts"] }
  },
  "include": ["src/*.ts"],
  "exclude": ["src/chromium"]
}
